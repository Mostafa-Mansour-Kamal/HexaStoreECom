@model ShoppingCartVM
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization

@inject IViewLocalizer localizer
@inject IOptions<HexaStoreECom.Utilities.StripeData> Stripe

@{
    ViewData["Title"] = "Order Summary";
}

<link href="~/css/summary.css" rel="stylesheet" />

<div class="container wrapper py-4">
    <div class="h5 large mb-3">@localizer["Billing Address"]</div>
    
    <form method="post">
        <div class="row">
            <!-- Billing Details Column -->
            <div class="col-lg-6 col-md-8 col-sm-10 offset-lg-0 offset-md-2 offset-sm-1">
                <div class="mobile h5 d-lg-none">@localizer["Billing Address"]</div>
                <div id="details" class="bg-white rounded p-4 mb-4 shadow-sm">

                    <div class="form-group mb-3">
                        <label class="text-muted fw-bold">@localizer["Name"]</label>
                        <input asp-for="OrderHeader.Name" type="text" class="form-control" />
                        <span asp-validation-for="OrderHeader.Name" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-lg-6">
                            <div class="form-group mb-3">
                                <label class="text-muted fw-bold">@localizer["City"]</label>
                                <div class="d-flex justify-content-start align-items-center rounded">
                                    <input asp-for="OrderHeader.City" type="text" class="form-control" />
                                </div>
                                <span asp-validation-for="OrderHeader.City" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="form-group mb-3">
                                <label class="text-muted fw-bold">@localizer["Phone Number"]</label>
                                <div class="d-flex justify-content-start align-items-center rounded">
                                    <input asp-for="OrderHeader.PhoneNumber" type="text" class="form-control" />
                                </div>
                                <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-group mb-3">
                                <label class="text-muted fw-bold">@localizer["Address"]</label>
                                <div class="d-flex justify-content-start align-items-center rounded">
                                    <input asp-for="OrderHeader.Address" type="text" class="form-control" />
                                </div>
                                <span asp-validation-for="OrderHeader.Address" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cart Summary Column -->
            <div class="col-lg-6 col-md-8 col-sm-10 offset-lg-0 offset-md-2 offset-sm-1">
                <div id="cart" class="bg-white rounded p-4 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center pb-3 border-bottom">
                        <div class="h6 font-weight-bold m-0">@localizer["Cart Summary"]</div>
                        <div class="h6 m-0">
                            <a asp-area="Customer" asp-controller="Cart" asp-action="Index" class="btn btn-sm btn-outline-secondary">@localizer["Edit"]</a>
                        </div>
                    </div>

                    <!-- Cart Items Loop -->
                    <div class="cart-items-container style-3" style="max-height: 350px; overflow-y: auto;">
                        @foreach (var item in Model.CartsList)
                        {
                            <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                                <div class="item pr-2 position-relative">
                                    @{
                                        // معالجة رابط الصورة ليعمل سواء كان رابطاً خارجياً أو داخلياً
                                        string imgPath = item.Product.Img ?? "";
                                        if (!imgPath.StartsWith("http") && !imgPath.StartsWith("/"))
                                        {
                                            imgPath = "/" + imgPath;
                                        }
                                    }
                                    <img src="@imgPath" alt="@item.Product.Name" width="70" height="70" class="rounded object-fit-cover" />
                                    <span class="badge badge-pill badge-dark position-absolute" style="top: -5px; right: -5px;">@item.Count</span>
                                </div>
                                <div class="d-flex flex-column px-3 flex-grow-1">
                                    <b class="h6 mb-0 text-truncate" style="max-width: 200px;">@item.Product.Name</b>
                                    <small class="text-muted">@localizer["Qty"]: @item.Count</small>
                                </div>
                                <div class="ml-auto text-right">
                                    <b class="h6">$@(item.Product.Price * item.Count)</b>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Total Price -->
                    <div class="d-flex align-items-center py-3">
                        <div class="display-5 font-weight-bold">@localizer["Total"]</div>
                        <div class="ml-auto d-flex align-items-center">
                            <div class="text-primary text-uppercase px-2 font-weight-bold">USD</div>
                            <div class="font-weight-bold h4 m-0 text-success">$@Model.OrderHeader.TotalPrice</div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row pt-3 mb-3">
                    <div class="col-md-6 mb-2">
                        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-block text-uppercase">
                            @localizer["back to shopping"]
                        </a>
                    </div>
                    <div class="col-md-6 mb-2">
                        <button type="submit" class="btn btn-primary btn-block text-uppercase font-weight-bold">
                            @localizer["Place Order"]
                        </button>
                    </div>
                </div>

                <div class="text-muted text-center pt-2">
                    <span class="fas fa-lock text-success mr-1"></span>
                    @localizer["Your information is save"]
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}